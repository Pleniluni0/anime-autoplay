{
  "manifest_version": 3,
  "name": "Anime AutoPlay",
  "version": "6.3.0",
  "description": "Autoplay for anime sites — countdown, intro skip, fullscreen, player memory.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.animeav1.com/*",
    "*://*.animeflv.net/*",
    "*://*.seriesdonghua.com/*",
    "*://*.mundodonghua.com/*",
    "*://*.donghualife.com/*",
    "*://*.jkanime.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.animeav1.com/*",
        "*://*.animeflv.net/*",
        "*://*.seriesdonghua.com/*",
        "*://*.mundodonghua.com/*",
        "*://*.donghualife.com/*",
        "*://*.jkanime.net/*"
      ],
      "js": ["i18n.js", "main.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://*.seriesdonghua.com/player.php*",
        "*://*.mundodonghua.com/player*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.dailymotion.com/*",
        "*://*.voe.sx/*",
        "*://*.streamtape.com/*",
        "*://*.filemoon.sx/*",
        "*://*.mdnemonicplayer.xyz/*",
        "*://*.mp4upload.com/*",
        "*://*.mega.nz/*",
        "*://*.upnshare.com/*",
        "*://*.pdrain.com/*",
        "*://*.jkanime.net/*",
        "*://*.vidhide.com/*",
        "*://*.vidhidepro.com/*",
        "*://*.vidhidevip.com/*"
      ],
      "js": ["i18n.js", "player.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Anime AutoPlay",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}